{
    "name": "monocart-reporter",
    "version": "2.12.6",
    "description": "A playwright test reporter. Shows suites/cases/steps with tree style, markdown annotations, custom columns/formatters/data collection visitors, console logs, style tags, send email.",
    "main": "lib/index.js",
    "bin": {
        "monocart": "lib/cli.js"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.js",
            "default": "./lib/index.js"
        },
        "./cli": "./lib/cli.js",
        "./package.json": "./package.json"
    },
    "types": "./lib/index.d.ts",
    "scripts": {
        "link": "node ./scripts/link.js",
        "test": "npm run link && npx playwright test -c tests",
        "test-example": "npm run link && npx playwright test tests/example -c tests",
        "test-data": "npm run link && npx playwright test tests/data -c tests",
        "test-page": "npm run link && npx playwright test tests/home-page -c tests",
        "test-coverage": "npm run link && npx playwright test tests/report-coverage -c tests",
        "test-network": "npm run link && npx playwright test tests/report-network -c tests",
        "test-state": "npm run link && npx playwright test tests/state -c tests",
        "dev": "vite",
        "dev-app": "vite --mode app",
        "dev-network": "vite --mode network",
        "build": "vite build",
        "lint": "eslint src/ --fix && stylelint \"src/**/*.scss\"",
        "version": "npm run build",
        "publish": "node ./scripts/publish.mjs",
        "patch": "npm run publish -- patch",
        "mock-download": "node ./scripts/mock-download.js",
        "mock-serve": "node ./scripts/mock-serve.js",
        "docs-report-gif": "node ./scripts/generate-report-gif.js"
    },
    "files": [
        "lib"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cenfun/monocart-reporter.git"
    },
    "dependencies": {
        "console-grid": "^2.2.4",
        "eight-colors": "^1.3.3",
        "koa": "^3.2.1",
        "koa-static-resolver": "^1.0.6",
        "lz-utils": "^2.1.1",
        "monocart-coverage-reports": "^2.13.0",
        "monocart-locator": "^1.0.3"
    },
    "devDependencies": {
        "@babel/code-frame": "^8.0.0",
        "@playwright/test": "^1.62.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "ansi-to-html": "^0.7.2",
        "async-tick": "^1.0.2",
        "axios": "^1.20.0",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-plus": "^2.1.0",
        "eslint-plugin-vue": "^10.10.0",
        "execa": "^10.0.1",
        "file-saver": "^2.0.5",
        "find-up": "^8.0.0",
        "github-markdown-css": "^5.9.0",
        "glob": "^13.0.6",
        "marked": "^18.0.11",
        "mermaid": "^11.17.2",
        "mitt": "^3.0.1",
        "monocart-code-viewer": "^1.2.0",
        "monocart-formatter": "^3.0.1",
        "nice-ticks": "^1.0.2",
        "node-stream-zip": "^1.16.0",
        "nodemailer": "^10.0.0",
        "open": "11.0.2",
        "rollup-plugin-visualizer": "^7.1.1",
        "sanitize-filename": "^1.6.4",
        "sass": "^1.104.0",
        "sharp": "^0.35.4",
        "stack-utils": "^2.0.6",
        "stylelint": "^17.15.0",
        "stylelint-config-plus": "^1.2.0",
        "supports-color": "^11.0.0",
        "turbogrid": "^3.4.1",
        "vine-ui": "^4.1.0",
        "vite": "^8.2.2",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "ws": "^8.21.3",
        "yazl": "^3.3.1"
    }
}
